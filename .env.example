# Public site configuration
HARA_LEARN_SITE=https://learn.hara-lang.org
PUBLIC_HARA_LEARN_MANAGE_SUBSCRIPTION_URL=https://buttondown.com/login?subscriber=1

# Neon subscriber, community identity, private draft, and proposal lifecycle ledger.
# Use the pooled connection string from the Neon Connect dialog.
DATABASE_URL=

# Trusted Hara Identity handoff and Learn-local session. Use different values in testing and production.
HARA_IDENTITY_ORIGIN=https://id.hara-lang.org
HARA_LEARN_HANDOFF_SECRET=
HARA_LEARN_SESSION_SECRET=

# Narrow GitHub App used to prepare review branches and draft pull requests.
HARA_LEARN_GITHUB_APP_ID=
HARA_LEARN_GITHUB_APP_PRIVATE_KEY=
HARA_LEARN_GITHUB_INSTALLATION_ID=
HARA_LEARN_GITHUB_REPOSITORY=hara-lang/hara-learn
HARA_LEARN_GITHUB_BASE_BRANCH=main

# GitHub App webhook for proposal lifecycle events. Configure the App webhook URL as:
# https://learn.hara-lang.org/api/github/events
HARA_LEARN_GITHUB_WEBHOOK_SECRET=

# Mailing-list confirmation and delivery
BUTTONDOWN_API_KEY=
BUTTONDOWN_WEBHOOK_SECRET=
BUTTONDOWN_FORWARD_IP=true
BUTTONDOWN_USE_TAGS=false
BUTTONDOWN_BYPASS_FIREWALL=false

# Release safety switch: adapter CLIs still require --publish unless this is true.
HARA_LEARN_PUBLISH=false

# Open social networks
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
MASTODON_VISIBILITY=public

# Optional provider-independent narration service
HARA_LEARN_TTS_ENDPOINT=
HARA_LEARN_TTS_TOKEN=
HARA_LEARN_TTS_VOICE=hara-learn
FFMPEG_PATH=ffmpeg

# YouTube OAuth refresh-token flow
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private

# Managed publisher / n8n / Buffer bridge for closed networks
HARA_PUBLISH_WEBHOOK_URL=
HARA_PUBLISH_WEBHOOK_SECRET=
