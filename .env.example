# Public site configuration
HARA_WORLD_SITE=https://world.hara-lang.org
PUBLIC_HARA_WORLD_MANAGE_SUBSCRIPTION_URL=https://buttondown.com/login?subscriber=1

# Neon subscriber ledger. Use the pooled connection string from the Neon Connect dialog.
DATABASE_URL=

# Mailing-list confirmation and delivery
BUTTONDOWN_API_KEY=
BUTTONDOWN_WEBHOOK_SECRET=
BUTTONDOWN_FORWARD_IP=true
BUTTONDOWN_USE_TAGS=false
BUTTONDOWN_BYPASS_FIREWALL=false

# Release safety switch: adapter CLIs still require --publish unless this is true.
HARA_WORLD_PUBLISH=false

# Open social networks
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
MASTODON_VISIBILITY=public

# Optional provider-independent narration service
HARA_WORLD_TTS_ENDPOINT=
HARA_WORLD_TTS_TOKEN=
HARA_WORLD_TTS_VOICE=hara-world
FFMPEG_PATH=ffmpeg

# YouTube OAuth refresh-token flow
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private

# Managed publisher / n8n / Buffer bridge for closed networks
HARA_PUBLISH_WEBHOOK_URL=
HARA_PUBLISH_WEBHOOK_SECRET=
