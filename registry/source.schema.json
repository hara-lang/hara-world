{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn.hara-lang.org/schemas/source-registry.json",
  "title": "Hara Learn source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "homepage", "feed", "status", "syndication", "permission", "topics"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
          "feed": { "type": "string", "format": "uri", "pattern": "^https://" },
          "status": { "enum": ["proposed", "active", "paused"] },
          "syndication": { "enum": ["link", "excerpt", "full"] },
          "permission": { "enum": ["owner", "authorised", "open-licence"] },
          "license": { "type": "string" },
          "defaultAuthor": { "type": "string" },
          "contact": { "type": "string" },
          "language": { "type": "string", "default": "en" },
          "maxItemsPerRun": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
