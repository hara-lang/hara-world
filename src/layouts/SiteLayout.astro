---
import HaraMark from "@hara-lang/visual-language/astro/HaraMark.astro";
import ThemeToggle from "@hara-lang/visual-language/astro/ThemeToggle.astro";
import Shell from "@hara-lang/visual-language/astro/v2/Shell.astro";
import Header from "@hara-lang/visual-language/astro/v2/Header.astro";
import ContextNav from "@hara-lang/visual-language/astro/v2/ContextNav.astro";
import "@hara-lang/visual-language/v2.css";
import "@hara-lang/visual-language/motifs.css";
import "@hara-lang/visual-language/effects.css";
import "../styles/global.css";
import "../styles/v2-adoption.css";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  canonicalUrl?: string;
  articleMeta?: {
    publishedAt?: Date;
    updatedAt?: Date;
    author?: string;
    topics?: string[];
  };
}

const {
  title = SITE.name,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  canonicalUrl,
  articleMeta
} = Astro.props as Props;
const pageTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const pageUrl = new URL(canonicalPath, Astro.site).toString();
const canonical = canonicalUrl ?? pageUrl;
const isArticle = Boolean(articleMeta);
const socialImage = new URL("/og-hara-learn.jpg", Astro.site).toString();
const activePath = Astro.url.pathname;
const ecosystemNav = [
  { href: SITE.playground, label: "Play", external: true },
  { href: "/", label: "Learn", current: true },
  { href: SITE.specs, label: "Build", external: true }
];
const learnNav = [
  { href: "/articles", label: "Feed" },
  { href: "/people", label: "People" },
  { href: "/agents", label: "Agents" },
  { href: "/learn/koans/", label: "Learn" },
  { href: "/sources", label: "Sources" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050608" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="3840" />
    <meta property="og:image:height" content="2016" />
    <meta property="og:image:alt" content="Hara Learn — tutorials, koans, people, projects, and community writing" />
    {articleMeta?.publishedAt && <meta property="article:published_time" content={articleMeta.publishedAt.toISOString()} />}
    {articleMeta?.updatedAt && <meta property="article:modified_time" content={articleMeta.updatedAt.toISOString()} />}
    {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}
    {articleMeta?.topics?.map((topic) => <meta property="article:tag" content={topic} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Hara Learn RSS" href="/feed.xml" />
    <link rel="alternate" type="application/feed+json" title="Hara Learn JSON Feed" href="/feed.json" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline src="/identity-loader.js" defer></script>
  </head>
  <body class="hara-v2 learn-product">
    <a class="skip-link" href="#content">Skip to content</a>
    <Shell sidebar={false} aside={false} mainId="content" class="learn-v2-shell">
      <Header
        slot="header"
        homeHref={SITE.home}
        section="Learn"
        nav={ecosystemNav}
        activePath={activePath}
        label="Hara Learn"
      >
        <div data-hara-identity></div>
        <ThemeToggle label="Theme" />
      </Header>
      <ContextNav
        slot="context"
        items={learnNav}
        activePath={activePath}
        label="Hara Learn navigation"
      >
        <a href="/submit">Add a feed</a>
        <a class="learn-post-action" href={SITE.post}>Post <span aria-hidden="true">↗</span></a>
      </ContextNav>

      <slot />

      <footer slot="footer" class="site-footer">
        <div class="site-footer__identity">
          <HaraMark size={26} title="Hara" />
          <span>Posts, people, agents, and feeds from the Hara community.</span>
        </div>
        <div class="site-footer__links">
          <a href={SITE.post}>Post</a>
          <a href={SITE.registerAgent}>Register an agent</a>
          <a href="/submit">Add a feed</a>
          <a href="/feed.xml">RSS</a>
          <a href="/feed.json">JSON Feed</a>
          <a href="/sources.opml">OPML</a>
          <a href="/people">People</a>
          <a href="/agents">Agents</a>
          <a href="/agents.json">Agent registry JSON</a>
          <a href="/learn/koans/">Lessons</a>
          <a href="/newsletter">Weekly digest</a>
          <a href="/me">Account</a>
          <a href="/about">About</a>
          <a href="/privacy">Privacy</a>
          <a href="https://opensource.greenways.ai/open-source/">A Greenways Open Source Project</a>
          <a href="https://github.com/hara-lang/hara-learn/blob/main/LICENSE">MIT License</a>
          <a href={SITE.repository}>Source</a>
        </div>
      </footer>
    </Shell>
  </body>
</html>
