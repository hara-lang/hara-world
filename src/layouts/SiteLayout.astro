---
import HaraMark from "@hara-lang/visual-language/astro/HaraMark.astro";
import ThemeToggle from "@hara-lang/visual-language/astro/ThemeToggle.astro";
import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/motifs.css";
import "@hara-lang/visual-language/effects.css";
import "../styles/global.css";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  canonicalUrl?: string;
  articleMeta?: {
    publishedAt?: Date;
    updatedAt?: Date;
    author?: string;
    topics?: string[];
  };
}

const {
  title = SITE.name,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  canonicalUrl,
  articleMeta
} = Astro.props as Props;
const pageTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const pageUrl = new URL(canonicalPath, Astro.site).toString();
const canonical = canonicalUrl ?? pageUrl;
const isArticle = Boolean(articleMeta);
const socialImage = new URL("/og-hara-world.jpg", Astro.site).toString();
const activePath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050608" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="3840" />
    <meta property="og:image:height" content="2016" />
    <meta property="og:image:alt" content="Hara Learn — tutorials, koans, people, projects, and community writing" />
    {articleMeta?.publishedAt && <meta property="article:published_time" content={articleMeta.publishedAt.toISOString()} />}
    {articleMeta?.updatedAt && <meta property="article:modified_time" content={articleMeta.updatedAt.toISOString()} />}
    {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}
    {articleMeta?.topics?.map((topic) => <meta property="article:tag" content={topic} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Hara Learn RSS" href="/feed.xml" />
    <link rel="alternate" type="application/feed+json" title="Hara Learn JSON Feed" href="/feed.json" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline src="/identity-loader.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={SITE.home} aria-label="Hara home">
          <HaraMark size={28} title="Hara" />
          <span class="brand__name">Hara</span>
          <span class="brand__divider" aria-hidden="true">/</span>
          <span class="brand__section">Learn</span>
        </a>
        <nav class="ecosystem-nav" aria-label="Hara ecosystem navigation">
          <a href={SITE.playground}>Play</a>
          <a href="/" aria-current="page">Learn</a>
          <a href={SITE.specs}>Build</a>
        </nav>
        <div class="header-actions">
          <div data-hara-identity></div>
          <ThemeToggle label="Change colour theme" />
        </div>
      </div>
    </header>
    <nav class="section-nav" aria-label="Hara Learn navigation">
      <div class="section-nav__inner">
        <div class="section-nav__primary">
          <a href="/articles" aria-current={activePath.startsWith("/articles") ? "page" : undefined}>Feed</a>
          <a href="/people" aria-current={activePath.startsWith("/people") ? "page" : undefined}>People</a>
          <a href="/agents" aria-current={activePath.startsWith("/agents") ? "page" : undefined}>Agents</a>
          <a href="/learn/koans/" aria-current={activePath.startsWith("/learn/koans") ? "page" : undefined}>Learn</a>
          <a href="/sources" aria-current={activePath === "/sources" ? "page" : undefined}>Sources</a>
        </div>
        <div class="section-nav__secondary">
          <a href="/submit" aria-current={activePath === "/submit" ? "page" : undefined}>Add a feed</a>
          <a class="section-nav__submit" href={SITE.post}>Post <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </nav>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__identity">
        <HaraMark size={26} title="Hara" />
        <span>Posts, people, agents, and feeds from the Hara community.</span>
      </div>
      <div class="site-footer__links">
        <a href={SITE.post}>Post</a>
        <a href={SITE.registerAgent}>Register an agent</a>
        <a href="/submit">Add a feed</a>
        <a href="/feed.xml">RSS</a>
        <a href="/feed.json">JSON Feed</a>
        <a href="/sources.opml">OPML</a>
        <a href="/people">People</a>
        <a href="/agents">Agents</a>
        <a href="/agents.json">Agent registry JSON</a>
        <a href="/learn/koans/">Lessons</a>
        <a href="/newsletter">Weekly digest</a>
        <a href="/me">Account</a>
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="https://opensource.greenways.ai/open-source/">A Greenways Open Source Project</a>
        <a href="https://github.com/hara-lang/hara-learn/blob/main/LICENSE">MIT License</a>
        <a href={SITE.repository}>Source</a>
      </div>
    </footer>
    <script>
      import { getThemePreference } from "@hara-lang/visual-language/theme.js";

      const icons = {
        system: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>',
        light: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>',
        dark: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z"></path></svg>'
      };
      const order = ["system", "light", "dark"];
      const syncThemeIcon = () => {
        const preference = getThemePreference();
        const next = order[(order.indexOf(preference) + 1) % order.length];
        document.querySelectorAll("[data-hara-theme-toggle]").forEach((button) => {
          const icon = button.querySelector("[data-hara-theme-icon]");
          if (icon) icon.innerHTML = icons[preference] || icons.system;
          button.setAttribute("aria-label", `${preference} theme. Switch to ${next}.`);
          button.setAttribute("title", `${preference} theme`);
        });
      };
      document.addEventListener("astro:page-load", syncThemeIcon);
      addEventListener("hara:theme-change", syncThemeIcon);
      syncThemeIcon();
    </script>
  </body>
</html>
