---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import LearnArrival from "../components/learn-home/LearnArrival.astro";
import LearnFirstLesson from "../components/learn-home/LearnFirstLesson.astro";
import LearnPaths from "../components/learn-home/LearnPaths.astro";
import LearnCommunity from "../components/learn-home/LearnCommunity.astro";
import LearnStart from "../components/learn-home/LearnStart.astro";
import { getArticles } from "../lib/articles";
import { KOANS } from "../lib/koans.mjs";
import "@hara-lang/visual-language/v2-icons.css";
import "../styles/learn-home-v2.css";

const articles = await getArticles();
const latest = articles.slice(0, 6);
const publishedProfiles = (await getCollection("profiles", ({ data }) => data.published))
  .sort((left, right) => right.data.joinedAt.getTime() - left.data.joinedAt.getTime());
const profiles = publishedProfiles.slice(0, 4);

const buildDay = Math.floor(Date.now() / 86_400_000);
const dailyLesson = KOANS[buildDay % KOANS.length];
const lessonBySlug = (slug: string) => KOANS.find((lesson) => lesson.slug === slug) ?? KOANS[0];
const lessonHref = (lesson: { slug: string }) => `/learn/koans/${lesson.slug}/`;

const entrances = [
  {
    number: "01",
    label: "New to programming",
    title: "Begin with a value.",
    summary: "Learn how values, names, collections, functions, and decisions fit together without assuming another language first.",
    outcome: "Read one expression and make its first test pass.",
    lesson: lessonBySlug("first-value")
  },
  {
    number: "02",
    label: "Programmed before",
    title: "Translate familiar ideas into Hara forms.",
    summary: "Start with functions and immutable data, then continue into sequences, maps, recursion, and explicit state.",
    outcome: "Write and test a small function in the browser workspace.",
    lesson: lessonBySlug("double-it")
  },
  {
    number: "03",
    label: "Familiar with Lisp",
    title: "Inspect Hara’s runtime and host boundaries.",
    summary: "Use familiar forms as the starting point, then examine threading, sessions, browser execution, and the surrounding ecosystem.",
    outcome: "Move from readable data to a named runtime deliberately.",
    lesson: lessonBySlug("threaded-data")
  }
].map((entrance) => ({ ...entrance, href: lessonHref(entrance.lesson) }));

const pathDefinitions = [
  {
    number: "01",
    title: "Values and collections",
    topics: ["values", "collections"],
    summary: "Read literals, keywords, vectors, maps, counts, positions, and collection joins.",
    outcome: "Represent and inspect ordinary program data."
  },
  {
    number: "02",
    title: "Functions and decisions",
    topics: ["functions", "decisions"],
    summary: "Define callable values, bind arguments, choose branches, and compose behaviour.",
    outcome: "Express reusable transformations and control flow."
  },
  {
    number: "03",
    title: "Sequences and maps",
    topics: ["sequences", "maps"],
    summary: "Transform collections, preserve order, aggregate values, and build indexed results.",
    outcome: "Work with persistent data as a pipeline."
  },
  {
    number: "04",
    title: "Recursion, forms, and state",
    topics: ["recursion", "forms", "state"],
    summary: "Use recursive definitions, threading forms, and a small explicit mutable boundary.",
    outcome: "Connect language structure to a running program."
  }
];

const paths = pathDefinitions.map((definition) => {
  const lessons = KOANS.filter((lesson) => definition.topics.includes(lesson.topic));
  const firstLesson = lessons[0] ?? KOANS[0];
  return {
    ...definition,
    lessonCount: lessons.length,
    firstLesson,
    href: lessonHref(firstLesson)
  };
});
---
<SiteLayout
  title="Learn Hara"
  description="Learn the Hara programming language through small readable programs, browser koans, explicit runtime boundaries, and community records."
>
  <div class="learn-home">
    <LearnArrival
      dailyLesson={dailyLesson}
      entrances={entrances}
      koanCount={KOANS.length}
      articleCount={articles.length}
      profileCount={publishedProfiles.length}
    />
    <LearnFirstLesson lesson={dailyLesson} koanCount={KOANS.length} />
    <LearnPaths paths={paths} />
    <LearnCommunity latest={latest} profiles={profiles} articleCount={articles.length} />
    <LearnStart dailyLesson={dailyLesson} />
  </div>
</SiteLayout>
