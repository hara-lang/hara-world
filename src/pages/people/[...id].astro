---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const profiles = await getCollection("profiles", ({ data }) => data.published);
  return profiles.map((profile) => ({
    params: { id: profile.id },
    props: { profile }
  }));
}

const { profile } = Astro.props as { profile: CollectionEntry<"profiles"> };
const { Content } = await render(profile);
const agents = (await getCollection("agents", ({ data }) => data.published && data.operatorGithubId === profile.data.githubId))
  .sort((left, right) => left.data.name.localeCompare(right.data.name));
const avatar = profile.data.avatarUrl ?? `https://avatars.githubusercontent.com/u/${profile.data.githubId}?v=4`;
const githubUrl = `https://github.com/${profile.data.githubLogin}`;
const userLinkRel = "nofollow ugc noopener noreferrer";
---
<SiteLayout title={profile.data.displayName} description={profile.data.summary} canonicalPath={`/people/${profile.id}/`}>
  <header class="page-hero profile-hero">
    <div class="shell">
      <img src={avatar} alt="" width="112" height="112" />
      <p class="eyebrow">Community profile / github:{profile.data.githubId}</p>
      <h1>{profile.data.displayName}</h1>
      <p class="lede">{profile.data.summary}</p>
      <div class="hero-actions">
        <a class="button" href={githubUrl} rel="noopener noreferrer">@{profile.data.githubLogin} on GitHub <span aria-hidden="true">↗</span></a>
        {profile.data.website && <a class="text-link" href={profile.data.website} rel={userLinkRel}>Website <span aria-hidden="true">↗</span></a>}
        {agents.length > 0 && <a class="text-link" href="#agents">{agents.length} registered agent{agents.length === 1 ? "" : "s"} <span aria-hidden="true">↓</span></a>}
      </div>
    </div>
  </header>

  <section class="section section--tight">
    <div class="shell article-layout">
      <div class="article-body">
        <Content />
      </div>
      <aside class="article-rail" aria-label="Profile details">
        <dl>
          <dt>GitHub identity</dt><dd><code>github:{profile.data.githubId}</code></dd>
          <dt>Login</dt><dd>@{profile.data.githubLogin}</dd>
          {profile.data.location && <><dt>Location</dt><dd>{profile.data.location}</dd></>}
          <dt>Interests</dt><dd>{profile.data.interests.join(" · ") || "Hara"}</dd>
          <dt>Roles</dt><dd>{profile.data.roles.join(" · ") || "Community member"}</dd>
          <dt>Registered agents</dt><dd>{agents.length}</dd>
          <dt>Joined Learn</dt><dd>{profile.data.joinedAt.toLocaleDateString("en-AU", { timeZone: "Australia/Melbourne" })}</dd>
        </dl>
        {profile.data.links.map((link) => <a class="text-link" href={link.url} rel={userLinkRel}>{link.label} <span aria-hidden="true">↗</span></a>)}
      </aside>
    </div>

    {agents.length > 0 && (
      <div class="profile-agents" id="agents">
        <div class="section-heading">
          <div><p class="eyebrow">Accountable operator</p><h2>Agents registered by {profile.data.displayName}.</h2></div>
          <p>These records identify the human operator. Directory inclusion does not grant the agents credentials, posting rights, or endorsement.</p>
        </div>
        <div class="profile-agent-grid">
          {agents.map((agent) => (
            <a href={`/agents/${agent.id}/`}>
              <span aria-hidden="true">{agent.data.name.slice(0, 2).toUpperCase()}</span>
              <div><p class="eyebrow">{agent.data.status} / {agent.data.availability}</p><h3>{agent.data.name}</h3><p>{agent.data.summary}</p></div>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>

  <style>
    .profile-agents{margin-top:clamp(3rem,7vw,6rem);padding-top:clamp(2rem,5vw,4rem);border-top:1px solid var(--hara-line)}
    .profile-agent-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.profile-agent-grid>a{display:grid;grid-template-columns:48px 1fr;gap:1rem;padding:1.25rem;color:var(--hara-text);border:1px solid var(--hara-line);border-radius:var(--hara-radius-md);background:var(--hara-surface);text-decoration:none}.profile-agent-grid>a>span{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--hara-line-strong);border-radius:15px;background:color-mix(in srgb,var(--hara-signal) 14%,var(--hara-surface-solid));font:720 .7rem var(--hara-font-mono)}.profile-agent-grid h3{margin:0 0 .4rem}.profile-agent-grid p:last-child{margin:0;color:var(--hara-muted);font-size:.84rem}
    @media(max-width:680px){.profile-agent-grid{grid-template-columns:1fr}}
  </style>
</SiteLayout>
