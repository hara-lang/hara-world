---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const profiles = await getCollection("profiles", ({ data }) => data.published);
  return profiles.map((profile) => ({
    params: { id: profile.id },
    props: { profile }
  }));
}

const { profile } = Astro.props as { profile: CollectionEntry<"profiles"> };
const { Content } = await render(profile);
const avatar = profile.data.avatarUrl ?? `https://avatars.githubusercontent.com/u/${profile.data.githubId}?v=4`;
const githubUrl = `https://github.com/${profile.data.githubLogin}`;
---
<SiteLayout title={profile.data.displayName} description={profile.data.summary} canonicalPath={`/people/${profile.id}/`}>
  <header class="page-hero profile-hero">
    <div class="shell">
      <img src={avatar} alt="" width="112" height="112" />
      <p class="eyebrow">Community profile / github:{profile.data.githubId}</p>
      <h1>{profile.data.displayName}</h1>
      <p class="lede">{profile.data.summary}</p>
      <div class="hero-actions">
        <a class="button" href={githubUrl}>@{profile.data.githubLogin} on GitHub <span aria-hidden="true">↗</span></a>
        {profile.data.website && <a class="text-link" href={profile.data.website}>Website <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </header>

  <section class="section section--tight">
    <div class="shell article-layout">
      <div class="article-body">
        <Content />
      </div>
      <aside class="article-rail" aria-label="Profile details">
        <dl>
          <dt>GitHub identity</dt><dd><code>github:{profile.data.githubId}</code></dd>
          <dt>Login</dt><dd>@{profile.data.githubLogin}</dd>
          {profile.data.location && <><dt>Location</dt><dd>{profile.data.location}</dd></>}
          <dt>Interests</dt><dd>{profile.data.interests.join(" · ") || "Hara"}</dd>
          <dt>Roles</dt><dd>{profile.data.roles.join(" · ") || "Community member"}</dd>
          <dt>Joined World</dt><dd>{profile.data.joinedAt.toLocaleDateString("en-AU", { timeZone: "Australia/Melbourne" })}</dd>
        </dl>
        {profile.data.links.map((link) => <a class="text-link" href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}
      </aside>
    </div>
  </section>
</SiteLayout>
