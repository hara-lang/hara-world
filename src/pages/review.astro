---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Review queue" description="The Hara Learn review queue for community posts, profiles, agents, and publication sources.">
  <header class="page-hero review-hero">
    <div class="shell">
      <p class="eyebrow">Community review / GitHub lifecycle</p>
      <h1>Review the Learn.</h1>
      <p class="lede">A read-only operational queue for trusted maintainers, editors, reviewers, and repository collaborators. GitHub remains the place where review comments, approvals, and merges are recorded.</p>
      <div class="hero-actions">
        <a class="button" href="/me">My Learn</a>
        <button class="button button--primary" type="button" data-reconcile hidden>Refresh every open proposal</button>
      </div>
    </div>
  </header>

  <section class="section section--tight">
    <div class="shell review-stack">
      <article class="review-access-panel">
        <div>
          <p class="eyebrow">Review authority</p>
          <h2 data-title>Checking access…</h2>
          <p data-copy>Learn is checking your active account and reviewed or repository-backed review authority.</p>
        </div>
        <a class="button button--primary" href="/api/auth/start?returnTo=/review" data-authorize hidden>Enable review access</a>
      </article>

      <div class="review-counts" data-counts hidden>
        <div><strong data-count-open>0</strong><span>Open</span></div>
        <div><strong data-count-changes>0</strong><span>Changes requested</span></div>
        <div><strong data-count-approved>0</strong><span>Approved</span></div>
        <div><strong data-count-failing>0</strong><span>Checks failing</span></div>
        <div><strong data-count-merged>0</strong><span>Recently published</span></div>
      </div>

      <div class="review-columns" data-queue hidden>
        <section class="review-column review-column--attention">
          <header><p class="eyebrow">Attention</p><h2>Changes or failing checks</h2></header>
          <div data-group-attention></div>
        </section>
        <section class="review-column">
          <header><p class="eyebrow">Incoming</p><h2>Needs review</h2></header>
          <div data-group-review></div>
        </section>
        <section class="review-column review-column--approved">
          <header><p class="eyebrow">Ready</p><h2>Approved</h2></header>
          <div data-group-approved></div>
        </section>
        <section class="review-column review-column--recent">
          <header><p class="eyebrow">History</p><h2>Recently resolved</h2></header>
          <div data-group-recent></div>
        </section>
      </div>
      <p class="form-status" data-status aria-live="polite"></p>
    </div>
  </section>

  <section class="section section--tight review-boundary">
    <div class="shell policy-grid">
      <article class="policy-card"><h3>Read-only queue</h3><p>This first version organises review state. Comments, approvals, requests for changes, and merges still happen in the canonical pull request.</p></article>
      <article class="policy-card"><h3>Derived authority</h3><p>Access comes from repository write permission or a reviewed profile role such as maintainer, editor, reviewer, or moderator.</p></article>
      <article class="policy-card"><h3>Signed events</h3><p>GitHub webhook deliveries are signature checked and deduplicated. Reconciliation repairs missed or delayed events.</p></article>
      <article class="policy-card"><h3>No hidden publishing</h3><p>Neither this page nor the lifecycle database can publish a record. Merge remains the public boundary.</p></article>
    </div>
  </section>

  <script>
    const $ = (selector) => document.querySelector(selector);
    const title = $("[data-title]");
    const copy = $("[data-copy]");
    const authorize = $("[data-authorize]");
    const reconcile = $("[data-reconcile]");
    const counts = $("[data-counts]");
    const queue = $("[data-queue]");
    const status = $("[data-status]");
    const groups = {
      attention: $("[data-group-attention]"),
      review: $("[data-group-review]"),
      approved: $("[data-group-approved]"),
      recent: $("[data-group-recent]"),
    };
    let initialised = false;

    const typeLabels = { post: "Post", profile: "Profile", agent: "Agent", source: "Feed" };
    const stateLabels = {
      submitted: "Waiting for review",
      "changes-requested": "Changes requested",
      approved: "Approved",
      merged: "Published",
      closed: "Closed",
      withdrawn: "Withdrawn",
      error: "Needs attention",
    };

    const api = async (options = {}) => {
      const response = await fetch("/api/review/proposals", {
        credentials: "include",
        cache: "no-store",
        ...options,
        headers: { Accept: "application/json", ...(options.headers || {}) },
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) {
        const error = new Error(body?.error?.message || `Learn returned HTTP ${response.status}.`);
        error.status = response.status;
        error.code = body?.error?.code;
        throw error;
      }
      return body;
    };

    const setCount = (selector, value) => {
      const node = $(selector);
      if (node) node.textContent = String(value ?? 0);
    };

    const proposalGroup = (proposal) => {
      if (proposal.state === "changes-requested" || proposal.state === "error" || proposal.checksState === "failing") return "attention";
      if (proposal.state === "approved" || proposal.reviewState === "approved") return "approved";
      if (["merged", "closed", "withdrawn"].includes(proposal.state)) return "recent";
      return "review";
    };

    const link = (href, label, className = "text-link") => {
      const node = document.createElement("a");
      node.href = href;
      node.className = className;
      node.textContent = label;
      if (href.startsWith("https://github.com/")) {
        node.target = "_blank";
        node.rel = "noopener noreferrer";
      }
      return node;
    };

    const card = (proposal) => {
      const article = document.createElement("article");
      article.className = `review-card review-card--${proposal.state}`;
      const head = document.createElement("header");
      const label = document.createElement("p");
      label.className = "eyebrow";
      label.textContent = `${typeLabels[proposal.proposalType] || proposal.proposalType} · github:${proposal.ownerGithubUserId}`;
      const heading = document.createElement("h3");
      heading.textContent = proposal.resourceTitle;
      const state = document.createElement("span");
      state.textContent = stateLabels[proposal.state] || proposal.state;
      state.className = "review-card__state";
      const identity = document.createElement("div");
      identity.append(label, heading);
      head.append(identity, state);

      const facts = document.createElement("div");
      facts.className = "review-card__facts";
      const values = [
        `Review: ${proposal.reviewState}`,
        `Checks: ${proposal.checksState}`,
        `Updated: ${proposal.updatedAt ? new Date(proposal.updatedAt).toLocaleString() : "—"}`,
      ];
      values.forEach((value) => {
        const span = document.createElement("span");
        span.textContent = value;
        facts.append(span);
      });

      const actions = document.createElement("footer");
      actions.append(link(proposal.pullRequestUrl, `Review PR #${proposal.pullRequestNumber} ↗`, "button"));
      if (proposal.state === "merged" && proposal.publicPath) actions.append(link(proposal.publicPath, "Open public record"));
      article.append(head, facts, actions);
      return article;
    };

    const empty = (message) => {
      const node = document.createElement("p");
      node.className = "review-column__empty";
      node.textContent = message;
      return node;
    };

    const render = (body) => {
      Object.values(groups).forEach((group) => group.replaceChildren());
      const proposals = Array.isArray(body.proposals) ? body.proposals : [];
      proposals.forEach((proposal) => groups[proposalGroup(proposal)].append(card(proposal)));
      const messages = {
        attention: "No proposals currently need corrective attention.",
        review: "No proposals are waiting for a first review.",
        approved: "No proposals are currently approved and awaiting merge.",
        recent: "No recently resolved proposals are recorded.",
      };
      Object.entries(groups).forEach(([name, group]) => {
        if (!group.childElementCount) group.append(empty(messages[name]));
      });
      setCount("[data-count-open]", body.counts?.open);
      setCount("[data-count-changes]", body.counts?.changesRequested);
      setCount("[data-count-approved]", body.counts?.approved);
      setCount("[data-count-failing]", body.counts?.failing);
      setCount("[data-count-merged]", body.counts?.merged);
      counts.hidden = false;
      queue.hidden = false;
      reconcile.hidden = false;
      title.textContent = body.reviewer?.source === "repository"
        ? `Repository review access: ${body.reviewer.permission}`
        : `Reviewed Learn role: ${(body.reviewer?.roles || []).join(", ")}`;
      copy.textContent = "The queue combines post, profile, agent, and source proposals using one lifecycle vocabulary.";
    };

    const load = async ({ reconcileNow = false } = {}) => {
      status.textContent = reconcileNow ? "Refreshing every open proposal from GitHub…" : "Loading review queue…";
      const body = await api(reconcileNow ? {
        method: "POST",
        headers: { "X-Hara-Request": "review-reconcile" },
      } : {});
      render(body);
      const failures = Array.isArray(body.reconciled) ? body.reconciled.filter((item) => !item.ok).length : 0;
      status.textContent = reconcileNow
        ? failures ? `${failures} proposal${failures === 1 ? "" : "s"} could not be refreshed.` : "All open proposals were reconciled with GitHub."
        : "Queue state is maintained by signed GitHub events and explicit reconciliation.";
    };

    reconcile?.addEventListener("click", async () => {
      reconcile.disabled = true;
      try { await load({ reconcileNow: true }); }
      catch (error) { status.textContent = error.message; }
      finally { reconcile.disabled = false; }
    });

    const initialise = async () => {
      if (initialised) return;
      initialised = true;
      try {
        const response = await fetch("/api/auth/session", { credentials: "include", headers: { Accept: "application/json" }, cache: "no-store" });
        const session = await response.json().catch(() => ({ authenticated: false }));
        if (!session?.authenticated) {
          title.textContent = session?.configured === false ? "Review access is not configured" : "Sign in to review Hara Learn";
          copy.textContent = "A Learn session is required before review authority can be checked.";
          authorize.hidden = session?.configured === false;
          status.textContent = "";
          return;
        }
        authorize.hidden = true;
        await load();
      } catch (error) {
        title.textContent = error.status === 403 ? "Review access required" : "Review queue unavailable";
        copy.textContent = error.message;
        authorize.hidden = true;
        status.textContent = "";
      }
    };

    document.addEventListener("astro:page-load", initialise);
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initialise, { once: true });
    else initialise();
  </script>

  <style>
    .review-hero{background:linear-gradient(145deg,color-mix(in srgb,var(--hara-signal) 8%,transparent),transparent 56%)}.review-stack{display:grid;gap:1.25rem}.review-access-panel{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:clamp(1.1rem,3vw,1.8rem);border:1px solid var(--hara-line);background:var(--hara-surface)}.review-access-panel h2{margin-bottom:.4rem}.review-access-panel p:last-child{margin:0;color:var(--hara-muted)}
    .review-counts{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-top:1px solid var(--hara-line);border-left:1px solid var(--hara-line)}.review-counts>div{display:grid;gap:.25rem;padding:1rem;border-right:1px solid var(--hara-line);border-bottom:1px solid var(--hara-line);background:var(--hara-surface)}.review-counts strong{font-size:1.6rem}.review-counts span{color:var(--hara-muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.06em}
    .review-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.review-column{display:grid;align-content:start;gap:.75rem;min-width:0;padding:1rem;border:1px solid var(--hara-line);background:color-mix(in srgb,var(--hara-surface) 78%,transparent)}.review-column>header{padding-bottom:.75rem;border-bottom:1px solid var(--hara-line)}.review-column h2{margin:0;font-size:1.2rem}.review-column>div{display:grid;gap:.75rem}.review-column--attention{border-top:3px solid #c86d3c}.review-column--approved{border-top:3px solid var(--hara-signal)}.review-column--recent{opacity:.9}
    .review-card{display:grid;gap:.8rem;padding:1rem;border:1px solid var(--hara-line);background:var(--hara-surface-solid)}.review-card header{display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem}.review-card h3{margin:0;font-size:1rem}.review-card .eyebrow{margin-bottom:.3rem}.review-card__state{padding:.3rem .5rem;border:1px solid var(--hara-line);border-radius:999px;color:var(--hara-muted);font:650 .58rem var(--hara-font-mono);text-transform:uppercase;white-space:nowrap}.review-card__facts{display:flex;flex-wrap:wrap;gap:.4rem .9rem;color:var(--hara-muted);font:.68rem var(--hara-font-mono)}.review-card footer{display:flex;align-items:center;flex-wrap:wrap;gap:.8rem;padding-top:.75rem;border-top:1px solid var(--hara-line)}.review-card footer .button{min-height:36px;padding:.55rem .75rem}.review-column__empty{margin:0;color:var(--hara-muted);font-size:.82rem}.review-boundary{border-top:1px solid var(--hara-line);background:var(--hara-bg-clean)}
    @media(max-width:900px){.review-counts{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media(max-width:720px){.review-access-panel{align-items:flex-start;flex-direction:column}.review-columns{grid-template-columns:1fr}.review-counts{grid-template-columns:repeat(2,minmax(0,1fr))}.review-card header{align-items:flex-start;flex-direction:column}}
  </style>
</SiteLayout>
